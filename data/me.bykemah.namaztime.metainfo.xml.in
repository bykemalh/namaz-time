<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>me.bykemah.namaztime</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>Namaz Vakti</name>
  <summary>Canlı namaz vakti sayacı</summary>
  <description>
    <p>Namaz Vakti, GNOME masaüstü için geliştirilmiş yerel bir GTK4 ve Libadwaita namaz vakitleri uygulamasıdır. Üç aşamalı Diyanet API yedeklemesi, akıllı yerel önbellek ve GNOME sistem tepsisi entegrasyonu sunar.</p>
    <ul>
      <li>Global ve Türkiye genelindeki tüm il ve ilçeler için IANA saat dilimi destekli vakitler</li>
      <li>GNOME üst çubuğunda canlı kalan süre ve tek tıkla açılan 6 vakitlik menü</li>
      <li>Otomatik doğrulamalı çoklu kaynak yedekleme (İmsakiyem, mtopal v1.5 ve İDA Medya)</li>
    </ul>
  </description>

  <developer id="io.github.bykemalh">
    <name>Kemal (@bykemalh)</name>
  </developer>

  <url type="homepage">https://github.com/bykemalh/namaz-time</url>
  <url type="bugtracker">https://github.com/bykemalh/namaz-time/issues</url>
  <url type="vcs-browser">https://github.com/bykemalh/namaz-time</url>
  <url type="contribute">https://github.com/bykemalh/namaz-time</url>
  <translation type="gettext">namaz-time</translation>
  <launchable type="desktop-id">me.bykemah.namaztime.desktop</launchable>
  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#1e8e74</color>
    <color type="primary" scheme_preference="dark">#0f5c4d</color>
  </branding>

  <releases>
    <release version="0.1.0" date="2026-11-16">
      <url type="details">https://github.com/bykemalh/namaz-time/releases/tag/v0.1.0</url>
      <description translate="no">
        <p>Namaz Vakti ilk sürümü: GNOME Adwaita arayüzü, sistem tepsisi menüsü ve üç kaynaklı Diyanet vakit altyapısı.</p>
      </description>
    </release>
  </releases>
</component>
