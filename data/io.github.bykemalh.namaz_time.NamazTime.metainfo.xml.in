      <caption>Live countdown and daily prayer times (Turkish)</caption>
      <image type="source" width="980" height="1500">https://raw.githubusercontent.com/bykemalh/namaz-time/v0.1.0/data/screenshot/image.png</image>
    </screenshot>
    <screenshot>
      <caption>Preferences dialog for data source, top bar, background mode, and language</caption>
      <image type="source" width="980" height="1500">https://raw.githubusercontent.com/bykemalh/namaz-time/v0.1.0/data/screenshot/settings_en.png</image>
    </screenshot>
    <screenshot>
      <caption>GNOME top bar tray menu with remaining time and all six prayers</caption>
