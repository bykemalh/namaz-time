<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.bykemalh.namaz_time.NamazTime</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>Prayer Times</name>
  <summary>Live prayer time countdown</summary>
  <description>
    <p>Prayer Times (Namaz Vakti) is a native GTK4 and Libadwaita prayer times application for GNOME. It offers three-stage Diyanet API fallback, smart offline caching, and GNOME system tray integration.</p>
    <ul>
      <li>IANA timezone-aware schedules for cities and districts worldwide and across Turkey</li>
      <li>Live countdown in the GNOME top bar with a quick six-prayer tray menu</li>
      <li>Verified multi-provider fallback (Imsakiyem, mtopal v1.5, and IDA Medya)</li>
    </ul>
  </description>

  <screenshots>
