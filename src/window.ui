<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="NamazTimeWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">Namaz Vakti</property>
    <property name="default-width">440</property>
    <property name="default-height">700</property>
    <property name="width-request">340</property>
    <property name="height-request">480</property>
    <property name="content">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <child type="start">
              <object class="GtkButton" id="location_button">
                <property name="tooltip-text" translatable="yes">Konumu değiştir</property>
                <style>
                  <class name="flat"/>
                  <class name="location-chip"/>
                </style>
                <child>
                  <object class="GtkBox">
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">namaz-location-symbolic</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="location_button_label">
                        <property name="label" translatable="yes">Konum Seç</property>
                        <property name="ellipsize">end</property>
                        <property name="max-width-chars">22</property>
                        <style>
                          <class name="heading"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">pan-down-symbolic</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton">
                <property name="primary">True</property>
                <property name="icon-name">open-menu-symbolic</property>
                <property name="tooltip-text" translatable="yes">Ana Menü</property>
                <property name="menu-model">primary_menu</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="refresh_button">
                <property name="icon-name">view-refresh-symbolic</property>
                <property name="tooltip-text" translatable="yes">Vakitleri yenile</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="AdwToastOverlay" id="toast_overlay">
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="AdwBanner" id="status_banner">
                    <property name="revealed">False</property>
                  </object>
                </child>
                <child>
                  <object class="AdwBanner" id="tray_warning_banner">
                    <property name="revealed">False</property>
                    <property name="title" translatable="yes">GNOME üst panelinde tepsi ikonu için AppIndicator eklentisi etkin değil.</property>
                    <property name="button-label" translatable="yes">Kapat</property>
                  </object>
                </child>
                <child>
                  <object class="GtkStack" id="main_stack">
                    <property name="vexpand">True</property>
                    <property name="transition-type">crossfade</property>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">empty</property>
                        <property name="child">
                          <object class="AdwStatusPage" id="empty_page">
                            <property name="icon-name">namaz-location-symbolic</property>
                            <property name="title" translatable="yes">Konum Seçin</property>
                            <property name="description" translatable="yes">Namaz vakitlerini, canlı geri sayımı ve sistem tepsisi bilgisini görmek için şehir veya ilçe seçin.</property>
                            <property name="child">
                              <object class="GtkButton" id="empty_select_button">
                                <property name="label" translatable="yes">Konum Seç</property>
                                <property name="halign">center</property>
                                <style>
                                  <class name="suggested-action"/>
                                  <class name="pill"/>
                                </style>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">loading</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="valign">center</property>
                            <property name="halign">center</property>
                            <property name="spacing">16</property>
                            <child>
                              <object class="GtkSpinner" id="loading_spinner">
                                <property name="spinning">True</property>
                                <property name="width-request">36</property>
                                <property name="height-request">36</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Namaz vakitleri alınıyor…</property>
                                <style>
                                  <class name="title-4"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">error</property>
                        <property name="child">
                          <object class="AdwStatusPage" id="error_page">
                            <property name="icon-name">namaz-error-symbolic</property>
                            <property name="title" translatable="yes">Vakitler Alınamadı</property>
                            <property name="description" translatable="yes">İnternet bağlantınızı kontrol edip tekrar deneyin.</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="spacing">12</property>
                                <property name="halign">center</property>
                                <child>
                                  <object class="GtkButton" id="error_retry_button">
                                    <property name="label" translatable="yes">Tekrar Dene</property>
                                    <style>
                                      <class name="suggested-action"/>
                                      <class name="pill"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="error_location_button">
                                    <property name="label" translatable="yes">Konum Değiştir</property>
                                    <style>
                                      <class name="pill"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">content</property>
                        <property name="child">
                          <object class="GtkScrolledWindow">
                            <property name="hscrollbar-policy">never</property>
                            <child>
                              <object class="AdwClamp">
                                <property name="maximum-size">500</property>
                                <property name="margin-top">16</property>
                                <property name="margin-bottom">20</property>
                                <property name="margin-start">16</property>
                                <property name="margin-end">16</property>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">16</property>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">10</property>
                                        <style>
                                          <class name="card"/>
                                          <class name="hero-card"/>
                                        </style>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="spacing">8</property>
                                            <child>
                                              <object class="GtkLabel" id="gregorian_date_label">
                                                <property name="hexpand">True</property>
                                                <property name="xalign">0</property>
                                                <style>
                                                  <class name="caption"/>
                                                  <class name="dim-label"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="hijri_date_label">
                                                <property name="xalign">1</property>
                                                <style>
                                                  <class name="caption"/>
                                                  <class name="dim-label"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="halign">center</property>
                                            <property name="margin-top">6</property>
                                            <child>
                                              <object class="GtkLabel" id="current_prayer_badge">
                                                <style>
                                                  <class name="pill-badge"/>
                                                  <class name="pill-badge-accent"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel" id="next_prayer_label">
                                            <property name="halign">center</property>
                                            <property name="margin-top">4</property>
                                            <style>
                                              <class name="title-4"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel" id="countdown_label">
                                            <property name="halign">center</property>
                                            <property name="label">00:00:00</property>
                                            <style>
                                              <class name="countdown-digits"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel" id="countdown_words_label">
                                            <property name="halign">center</property>
                                            <style>
                                              <class name="dim-label"/>
                                              <class name="body"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkProgressBar" id="interval_progress">
                                            <property name="margin-top">6</property>
                                            <style>
                                              <class name="hero-progress"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel" id="timezone_label">
                                            <property name="halign">center</property>
                                            <property name="margin-top">2</property>
                                            <style>
                                              <class name="caption"/>
                                              <class name="dim-label"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkListBox" id="prayers_list">
                                        <property name="selection-mode">none</property>
                                        <style>
                                          <class name="boxed-list"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="source_label">
                                        <property name="halign">center</property>
                                        <property name="wrap">True</property>
                                        <property name="justify">center</property>
                                        <style>
                                          <class name="caption"/>
                                          <class name="dim-label"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Tercihler</attribute>
        <attribute name="action">app.preferences</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Klavye Kısayolları</attribute>
        <attribute name="action">app.shortcuts</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Namaz Vakti Hakkında</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Çıkış</attribute>
        <attribute name="action">app.quit</attribute>
      </item>
    </section>
  </menu>
</interface>
