msgstr "Görüntüleme dili seçimi: system, tr, en veya ru."

#: data/io.github.bykemalh.namaz_time.NamazTime.gschema.xml:46
msgid "Hero card background theme"
msgstr "Ana kart arka plan teması"

#: data/io.github.bykemalh.namaz_time.NamazTime.gschema.xml:47
msgid ""
"Selected hero card scene: sultanahmet, ayasofya, suleymaniye, or classic."
